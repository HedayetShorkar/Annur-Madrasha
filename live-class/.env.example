NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:5173
DB_PATH=./data/live.sqlite
# 1 only when the loopback-only API is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# Server only; get these from your LiveKit deployment. Never prefix with VITE_.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Bootstrap command only. Remove password after creating first administrator.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
