NODE_ENV=development
PORT=4100
APP_ORIGIN=http://localhost:5173
DB_PATH=./data/live.sqlite
# 1 only when the loopback-only API is behind exactly one trusted reverse proxy.
TRUST_PROXY_HOPS=0
# New installations use Jitsi. Existing LiveKit-only environments keep working.
VIDEO_PROVIDER=jitsi
# self-hosted (HS256) or jaas (RS256). Server-only settings; never use VITE_.
JITSI_MODE=self-hosted
# Your trusted HTTPS Jitsi host, e.g. meet.your-domain.example; no path.
JITSI_DOMAIN=
JITSI_APP_ID=
# Same secret as the JWT-protected Jitsi server, at least 32 bytes.
JITSI_APP_SECRET=
# Optional: self-hosted JWT subject (Docker commonly uses meet.jitsi).
JITSI_SUBJECT=
JITSI_AUDIENCE=
# JaaS only: AppID/key-id and a private PEM kept outside the public/source tree.
# JITSI_MODE=jaas; JITSI_APP_ID=vpaas-magic-cookie-...; JITSI_DOMAIN=8x8.vc
JITSI_KEY_ID=
JITSI_PRIVATE_KEY_FILE=
# Legacy option: set VIDEO_PROVIDER=livekit to use these credentials instead.
LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
# Bootstrap command only. Remove password after creating first administrator.
ADMIN_NAME=Administrator
ADMIN_EMAIL=
ADMIN_PASSWORD=
