{
  "name": "annoor-live-class",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "start": "node --env-file-if-exists=.env server/index.js",
    "bootstrap": "node --env-file-if-exists=.env server/bootstrap.js",
    "build": "vite build && node scripts/portable-build.mjs",
    "test": "node --test tests/*.test.js",
    "stage": "node scripts/stage-public.mjs"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "@livekit/components-react": "2.9.24",
    "@livekit/components-styles": "1.2.0",
    "livekit-client": "2.23.0",
    "livekit-server-sdk": "2.19.1",
    "express": "5.1.0",
    "express-rate-limit": "8.1.0",
    "helmet": "8.1.0",
    "bcryptjs": "3.0.2"
  },
  "devDependencies": {
    "vite": "7.3.7",
    "@vitejs/plugin-react": "5.2.0",
    "supertest": "7.1.4"
  },
  "engines": {
    "node": ">=24.19.0"
  }
}
