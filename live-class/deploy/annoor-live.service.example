[Unit]
Description=AnNoor live classroom API
After=network-online.target
Wants=network-online.target
[Service]
Type=simple
User=annoor
Group=annoor
WorkingDirectory=/srv/annoor/source/live-class
EnvironmentFile=/etc/annoor/live.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/annoor-live
[Install]
WantedBy=multi-user.target
