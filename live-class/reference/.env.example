# এই ফাইলটা কপি করে .env নাম দিন, তারপর মান বসান

PORT=4000
FRONTEND_ORIGIN=https://আপনার-ওয়েবসাইট.com

# লম্বা র‍্যান্ডম লেখা দিন (যেমন: openssl rand -hex 32 চালিয়ে পাওয়া)
AUTH_SECRET=

# শিক্ষকরা রেজিস্টার করতে এই কোড ব্যবহার করবে, শুধু আপনি জানবেন
TEACHER_SIGNUP_CODE=

# Jitsi সার্ভারের তথ্য
JITSI_DOMAIN=meet.আপনার-ডোমেইন.com
JITSI_APP_ID=myclassapp
JITSI_APP_SECRET=
