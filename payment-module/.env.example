# PUBLIC browser configuration only. Supabase publishable/anon key is not privileged.
# Keep false until the online service and receiving accounts are ready.
VITE_ENABLE_ONLINE_PAYMENTS=false
# Leave these blank for the manual receipt desk; set real public values only
# when preparing the future online gateway integration.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# NEVER put a service_role key, device secret, PIN or OTP in a VITE_ variable.
